# ============================================================================
# HappyLMS CRM - Environment Variables Configuration Template
# Copy this file to .env.local and fill in your credentials
# ============================================================================

# 1. SUPABASE DATABASE & AUTH (Required)
# Create a free project at https://supabase.com
# Go to Project Settings -> API to find your URL and anon key:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. EMAIL NOTIFICATIONS (Optional - for Lead assignment & Welcome emails)
# Option A: Gmail SMTP (Recommended - zero sandbox limits)
# Generate an App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Option B: Resend API (Alternative fallback)
# Get a free key at: https://resend.com
RESEND_API_KEY=re_your_api_key_here
